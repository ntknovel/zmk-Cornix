/*
 * Cornix ZMK keymap converted from the user's Vial/RMK backup: "내 코르닉스.vil".
 *
 * Conversion target:
 *   - 8 key layers / 50 physical key positions (Base + STENO + Select Nav)
 *   - 2 encoders per layer
 *   - 13 active combos
 *   - Base bracket dual-role keys plus the existing tap-vs-hold actions
 *
 * RF and battery settings remain in config/cornix.conf.
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/cornix_steno.h>

#define BASE    0
#define NUM     1
#define MOUSE   2
#define NAV     3
#define FN      4
#define SYMBOL  5
#define STENO   6
#define SELECT_NAV 7

#include "cornix_steno.dtsi"

/ {
    behaviors {
        /*
         * QMK/Vial layer-tap approximation:
         * - Tapping Term: 250 ms
         * - Flow Tap: 120 ms (require-prior-idle-ms)
         * - balanced flavor keeps quick layer chords usable.
         *
         * Vial's Chordal Hold cannot be copied bit-for-bit without a
         * hand/position policy, so this is the closest safe general behavior.
         */
        lt250: layer_tap_250 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            require-prior-idle-ms = <120>;
            display-name = "Layer-Tap 250ms";
        };

        /* Vial tap-dance entries used by this keymap: tap key / hold key. */
        ht300: hold_tap_300 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            display-name = "Tap-Hold 300ms";
        };

        ht200: hold_tap_200 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            display-name = "Tap-Hold 200ms";
        };

        ht150: hold_tap_150 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            display-name = "Tap-Hold 150ms";
        };

        /*
         * Runtime BLE TX power controls.
         * Short labels are intentional: global split behaviors are dispatched
         * to both halves, so compact behavior identifiers are safest.
         *
         * Command values:
         *   0 = decrease, 1 = set 0 dBm, 2 = increase, 3 = set +8 dBm.
         */
        rf0: rf0 {
            compatible = "zmk,behavior-rf-power";
            #binding-cells = <0>;
            command = <1>;
            display-name = "TX 0 dBm";
        };

        rfu: rfu {
            compatible = "zmk,behavior-rf-power";
            #binding-cells = <0>;
            command = <2>;
            display-name = "TX Power +";
        };

        rfd: rfd {
            compatible = "zmk,behavior-rf-power";
            #binding-cells = <0>;
            command = <0>;
            display-name = "TX Power -";
        };

        rfm: rfm {
            compatible = "zmk,behavior-rf-power";
            #binding-cells = <0>;
            command = <3>;
            display-name = "TX MAX +8";
        };
    };

    macros {
        /*
         * Cornix STENO selection key: hold real RShift and temporarily
         * replace physical J/L/K/I with Left/Right/Down/Up.
         */
        select_shift: select_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo SELECT_NAV &kp RSHIFT>
                , <&macro_pause_for_release>
                , <&macro_release &mo SELECT_NAV &kp RSHIFT>
                ;
        };


        /* BEGIN CORNIX QUICK MACROS (generated from config/steno_quick_text.tsv) */
        /*
         * Standard ZMK macros visible in the Keymap Editor Macros panel.
         * Fixed STENO input masks are dispatched to stable M0..M11 nodes.
         * Edit the bindings in the GUI, or edit steno_quick_text.tsv and rerun
         * tools/update_quick_macro_text.py.
         */
        /* M0: 약어L+ㅡ -> 사구구 */
        quick_0: quick_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M0 Quick L+EU";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp T &kp K &kp R &kp N &kp R &kp N>;
        };

        /* M1: 약어L+ㅗ -> 구서룡 */
        quick_1: quick_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M1 Quick L+O";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp R &kp N &kp T &kp J &kp F &kp Y &kp D>;
        };

        /* M2: 약어L+ㅜ -> 피피쿵 */
        quick_2: quick_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M2 Quick L+U";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp V &kp L &kp V &kp L &kp Z &kp N &kp D>;
        };

        /* M3: 약어R+ㅏ -> 스타라이트 */
        quick_3: quick_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M3 Quick R+A";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp T &kp M &kp X &kp K &kp F &kp K &kp D &kp L &kp X &kp M>;
        };

        /* M4: 약어R+ㅣ -> 유안나 */
        quick_4: quick_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M4 Quick R+I";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp D &kp B &kp D &kp K &kp S &kp S &kp K>;
        };

        /* M5: 약어R+ㅓ -> 유혜나 */
        quick_5: quick_5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M5 Quick R+EO";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp D &kp B &kp G &kp LS(P) &kp S &kp K>;
        };

        /* M6: 약어L+ㅏ -> 실험체 */
        quick_6: quick_6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M6 Quick L+A";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp T &kp L &kp F &kp G &kp J &kp A &kp C &kp P>;
        };

        /* M7: 약어L+ㅓ -> A 시 */
        quick_7: quick_7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M7 Quick L+EO";
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp RALT &kp LS(A) &kp SPACE &kp RALT &kp T &kp L>;
        };

        /* M8: 약어L+ㅣ -> W 시 */
        quick_8: quick_8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M8 Quick L+I";
            wait-ms = <80>;
            tap-ms = <40>;
            bindings = <&kp RALT &kp LS(W) &kp SPACE &kp RALT &kp T &kp L>;
        };

        /* M9: 약어R+ㅗ -> 케이지 */
        quick_9: quick_9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M9 Quick R+O";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp Z &kp P &kp D &kp L &kp W &kp L>;
        };

        /* M10: 약어R+ㅜ -> 일렉트리스 */
        quick_10: quick_10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M10 Quick R+U";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp D &kp L &kp F &kp F &kp P &kp R &kp X &kp M &kp F &kp L &kp T &kp M>;
        };

        /* M11: 약어R+ㅡ -> 마이스터 */
        quick_11: quick_11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "M11 Quick R+EU";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp A &kp K &kp D &kp L &kp T &kp M &kp X &kp J>;
        };
        /* END CORNIX QUICK MACROS */
    };

    combos {
        compatible = "zmk,combos";

        combo_grave {
            timeout-ms = <50>;
            key-positions = <0 12>;
            bindings = <&kp GRAVE>;
            layers = <BASE>;
        };
        combo_num_1 {
            timeout-ms = <50>;
            key-positions = <1 13>;
            bindings = <&kp N1>;
            layers = <BASE>;
        };
        combo_num_2 {
            timeout-ms = <50>;
            key-positions = <2 14>;
            bindings = <&kp N2>;
            layers = <BASE>;
        };
        combo_num_3 {
            timeout-ms = <50>;
            key-positions = <3 15>;
            bindings = <&kp N3>;
            layers = <BASE>;
        };
        combo_num_4 {
            timeout-ms = <50>;
            key-positions = <4 16>;
            bindings = <&kp N4>;
            layers = <BASE>;
        };
        combo_num_5 {
            timeout-ms = <50>;
            key-positions = <5 17>;
            bindings = <&kp N5>;
            layers = <BASE>;
        };
        combo_num_6 {
            timeout-ms = <50>;
            key-positions = <6 18>;
            bindings = <&kp N6>;
            layers = <BASE>;
        };
        combo_num_7 {
            timeout-ms = <50>;
            key-positions = <7 19>;
            bindings = <&kp N7>;
            layers = <BASE>;
        };
        combo_num_8 {
            timeout-ms = <50>;
            key-positions = <8 20>;
            bindings = <&kp N8>;
            layers = <BASE>;
        };
        combo_num_9 {
            timeout-ms = <50>;
            key-positions = <9 21>;
            bindings = <&kp N9>;
            layers = <BASE>;
        };
        combo_num_0 {
            timeout-ms = <50>;
            key-positions = <10 22>;
            bindings = <&kp N0>;
            layers = <BASE>;
        };

        /* J+K and D+F momentarily open the Symbols layer. */
        combo_symbol_jk {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mo SYMBOL>;
            layers = <BASE NUM FN>;
            slow-release;
        };
        combo_symbol_df {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&mo SYMBOL>;
            layers = <BASE NUM FN>;
            slow-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LC(A)
                &kp CAPSLOCK  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &ht300 SQT DQT
                &kp LSHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &st_mode  &st_lang_return  &kp N  &kp M  &kp COMMA  &kp DOT  &ht200 FSLH QUESTION  &kp RSHIFT
                &kp LCTRL  &kp LALT  &ht200 LC(Y) LBKT  &lt250 NUM LGUI  &lt250 MOUSE MINUS  &kp ENTER  &kp SPACE  &lt250 NAV EQUAL  &lt250 FN K_APP  &ht200 RCTRL RBKT  &kp RALT  &kp BSPC
            >;
            sensor-bindings = <&inc_dec_kp UP DOWN  &inc_dec_kp RIGHT LEFT>;
        };

        num_layer {
            display-name = "Num";
            bindings = <
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp LBKT  &kp RBKT  &kp DEL
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &kp C_STOP  &kp C_PLAY_PAUSE  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &inc_dec_kp C_NEXT C_PREV>;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &trans  &trans  &none  &mmv MOVE_UP  &none  &none  &mkp MB4  &mkp MB1  &msc SCRL_UP  &mkp MB2  &mkp MB5  &kp DEL
                &trans  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &none  &kp SQT
                &trans  &none  &none  &none  &none  &none  &kp PSCRN  &kp LC(F)  &none  &none  &none  &none  &kp FSLH  &trans
                &kp LCTRL  &kp LGUI  &kp LALT  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &ht150 RBKT LBKT  &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(TAB) LC(LS(TAB))  &inc_dec_kp LC(Y) LC(Z)>;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &kp GRAVE  &none  &none  &kp PG_UP  &none  &none  &none  &none  &kp UP  &kp LBKT  &kp RBKT  &trans
                &none  &none  &kp HOME  &kp PG_DN  &kp END  &none  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &kp SQT
                &trans  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &kp BSLH  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RALT  &trans  &kp RCTRL
            >;
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP  &inc_dec_kp LS(PG_DN) LS(PG_UP)>;
        };

        fn_layer {
            display-name = "Fn-BT";
            bindings = <
                &bt BT_NXT  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &bt BT_PRV
                &bt BT_SEL 0  &rf0  &rfu  &rfd  &rfm  &st_led_toggle  &trans  &trans  &trans  &trans  &trans  &trans
                &bt BT_SEL 1  &trans  &trans  &trans  &trans  &trans  &kp F11  &kp F12  &trans  &trans  &trans  &trans  &trans  &trans
                &bt BT_SEL 2  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP  &inc_dec_kp LS(PG_DN) LS(PG_UP)>;
        };

        symbol_layer {
            display-name = "Symbols";
            bindings = <
                &kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTERISK  &kp LPAR  &kp RPAR  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp SQT
                &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(A)  &kp LC(F)  &trans  &trans  &trans  &trans  &kp QUESTION  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };


        /*
         * Cornix STENO v2.0 two-set-consonant layout + 43 canonical exact-mask
         * abbreviations and 12 GUI-editable quick macros. Physical convenience keys are outside the logical
         * abbreviation role mask.
         */
        steno_layer {
            display-name = "STENO-KO";
            bindings = <
                &st_tab_once  &st_i_b  &st_i_j  &st_i_d  &st_i_g  &st_i_s  &st_f_s  &st_f_g  &st_f_d  &st_f_j  &st_f_b  &ht150 RCTRL RALT
                &st_abbr_l  &st_i_m  &st_i_n  &st_i_ng  &st_i_r  &st_i_h  &st_f_h  &st_f_r  &st_f_ng  &st_f_n  &st_f_m  &st_abbr_r
                &st_vext_l  &st_i_kh  &st_i_t  &st_i_ch  &st_i_p  &st_i_double  &st_mode  &st_lang_return  &st_f_double  &st_f_p  &st_f_ch  &st_f_t  &st_f_kh  &st_vext_r
                &kp LCTRL  &kp LALT  &st_symbol_l  &st_v_o  &st_v_eu  &st_vu_enter  &st_va_space  &st_v_i  &st_v_eo  &st_symbol_r  &select_shift  &kp BSPC
            >;
            sensor-bindings = <&st_enc LS(UP) LS(DOWN)  &st_enc UP DOWN>;
        };

        /*
         * Activated only while the dedicated right-hand Select Shift key is
         * held. Other positions are blocked so no STENO role leaks into a
         * selection gesture.
         */
        select_nav_layer {
            display-name = "Select Nav";
            bindings = <
                &none  &none  &none  &none  &none  &none  &none  &none  &kp UP  &none  &none  &none
                &none  &none  &none  &none  &none  &none  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
